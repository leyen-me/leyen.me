# Sanity (read — public project/dataset only)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2023-07-21
NEXT_PUBLIC_SANITY_HOOK_SECRET=

# Sanity (write — server only, never expose to browser)
SANITY_API_TOKEN=

# Admin auth (server only)
ADMIN_PASSWORD=
SESSION_SECRET=

# AI (OpenAI-compatible — server only)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
# Admin AI model (slug, post content, etc.)
# Use deepseek-chat for JSON tasks — reasoning models may truncate output
AI_MODEL=deepseek-chat

# GitHub Graph
NEXT_PUBLIC_GITHUB_USERNAME="your-github-username"
NEXT_PUBLIC_GITHUB_JOIN_YEAR="year-you-joined-github"
